web/node_modules/
web/.next/
web/.env*
!web/.env.example
web/tsconfig.tsbuildinfo
# Cloudflare build output: the OpenNext bundle and wrangler's local state.
web/.open-next/
web/.wrangler/
web/playwright-report/
web/test-results/
.website-backups/
.website-runtime/
web/.impeccable/
.remember/tmp/

# Source clips dropped at the repo root before encoding into web/public/video/
/*.mp4

# Local tunnel tooling: the ngrok agent and the account token behind run.bat.
# The binary is a 32 MB download and the token is a credential — neither belongs in git.
# The reserved hostname is not a secret, so it is committed: every machine then opens
# the same public link without a per-machine setup step.
/tools/ngrok.exe
/tools/ngrok.yml

# Per-machine Claude Code permissions; the shared launch config stays.
.claude/settings.local.json
