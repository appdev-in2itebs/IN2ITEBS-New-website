# Preview is the default. Set production only for an approved production release.
SITE_ENV=preview
# Approved HTTPS adapter must durably accept the lead before returning HTTP 2xx.
# Keep secrets in .env.local, never in source control or chat.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
# Makes the server trust X-Forwarded-For, X-Forwarded-Host and X-Forwarded-Proto.
# Enable only behind an ingress that overwrites all three. The per-address rate limit
# takes the LEFTMOST X-Forwarded-For value, so it is safe only where the ingress
# overwrites the header (Sucuri does). Ingresses that APPEND the connecting IP to
# whatever the client sent (Cloudflare-style) are not eligible: the leftmost value is
# then client-controlled and the per-address limit becomes spoofable. Leave this 0
# unless the overwrite behaviour has been confirmed on the final proxy.
TRUST_PROXY_HEADERS=0
# Extra browser origins allowed to submit the enquiry form (comma-separated), e.g. a staging host.
ALLOWED_ORIGINS=
# Public site origin used for canonical URLs and the enquiry origin allowlist
# (baked in at build time; set it before `next build`).
NEXT_PUBLIC_SITE_URL=https://in2itebs.com

# --- Supabase -----------------------------------------------------------------
# Project URL: Supabase -> Settings -> Data API.
SUPABASE_URL=
# Secret key (sb_secret_...): Supabase -> Settings -> API Keys.
# It bypasses row-level security, so it is server-only: never prefix it NEXT_PUBLIC_,
# never import it into a client component, never commit it. In CI it lives in GitHub
# Secrets and is pushed to Cloudflare as a Worker secret by .github/workflows/deploy.yml.
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_...). Used only to sign admins in to /admin (Supabase
# Auth). Safe in a browser: with row-level security on and no policies it reads no data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# The AI assistant (chat): an NVIDIA API key from build.nvidia.com. Server-only, never NEXT_PUBLIC_.
# Without it the chat answers from the Chatbot FAQs. In CI it is the NVIDIA_API_KEY GitHub secret,
# pushed to Cloudflare as a Worker secret by .github/workflows/deploy.yml.
NVIDIA_API_KEY=

# Voice for the chat assistant (Sarvam AI: speech to text and text to speech in Indian languages).
# Server-only. Without it the chat uses the browser's own voice. In CI: the SARVAM_API_KEY GitHub secret.
SARVAM_API_KEY=
