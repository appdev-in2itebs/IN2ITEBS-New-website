{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "in2it-ebs-web",
  "main": ".open-next/worker.js",
  // Minified, function names kept (keep_names is on by default): the compressed Worker drops from
  // about 3.07 MiB to 2.65 MiB, under the 3 MiB limit of the free Workers plan.
  "minify": true,

  // nodejs_compat is required: lib/lead-service.ts imports node:crypto and
  // app/api/lead/route.ts runs on the nodejs runtime. Without the flag the
  // Worker fails to start. global_fetch_strictly_public keeps fetch() to the
  // public internet rather than looping back into this Worker.
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Every prerendered page plus web/public/ — 1,695 files — is served straight
  // from Cloudflare's edge, not through the Worker.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // SITE_ENV is read at build time for robots.txt and the X-Robots-Tag header, but the health
  // route reports it at runtime too, and a Worker has no process environment of its own — without
  // this it answered "unset" on a site that was clearly a preview. Keep it in step with the
  // SITE_ENV the deploy workflow builds with.
  "vars": {
    "SITE_ENV": "preview"
  },

  // Cloudflare Images: lets /_next/image resize each picture to the width the device asks for and
  // re-encode it as AVIF or WebP. Without it OpenNext hands every visitor the original file, full
  // size, through the Worker. Billed as Images transformations (5,000 unique a month free).
  "images": {
    "binding": "IMAGES"
  },

  // Instant content editing (open-next.config.ts). The page cache lives in this R2 bucket; create it
  // once in the Cloudflare dashboard (R2 -> Create bucket -> in2it-ebs-next-cache) before deploying.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "in2it-ebs-next-cache"
    }
  ],

  // The two Durable Objects that mark edited pages stale and re-render them in the background.
  // Cloudflare creates them on deploy (the migration below); nothing to set up by hand.
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [
    {
      "tag": "v1-next-cache",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"]
    }
  ],

  // The background re-render calls this same Worker.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "in2it-ebs-web"
    }
  ],

  "observability": {
    "enabled": true
  }
}
